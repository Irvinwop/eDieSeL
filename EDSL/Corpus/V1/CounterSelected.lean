import EDSL.Corpus.V1.CounterProofBundle
import EDSL.Corpus.V1.CounterFrame
import EDSL.Corpus.V1.CounterRetirement

set_option autoImplicit false
set_option warningAsError true
set_option maxHeartbeats 300000
set_option maxRecDepth 128

/-!
Resource and byte-frame assembly from explicitly selected counter proofs.
Each subject retains its supplied bundle's exact annotations and entry node;
the generic cohort never selects a compiler proof from admission. Full-log
counts and events concern the same actual production schedule as the checked
registered-address frame and OS-history sequentialization.

Current cleanup readiness uses the selected bundle's preserved resource record,
successful-schedule validity, original cleanup shape and derived empty queues.
Original separation transports through that same schedule before production
retireAll executes against the actual final world. Current RAM, cells, ownership
resources, returned contexts, logical history and revocations are retained.

The existing target, authority, lifetime, synchronization, protected-loan,
coherent scalar WB RAM, CET/IBT-off and translation/no-alias assumptions remain.
Scheduler slots are independent of resource actors. These conditional finite-run
theorems add no termination, native join, compiler/hardware refinement or corpus
credit claim, and leave the existing compatibility helpers unchanged.
-/

namespace EDSL.Corpus.V1.CounterCommon.Selected
open X86 OS OS.TSO64 OS.TSO64.EffectSimulation

/-- Project each explicit subject's own proof into an arbitrary-index cohort.
The annotations remain those generated by that bundle's retained local rules. -/
def provedCohort {ι : Type} {initial : S} (subjects : ι → ProvedSubject initial) :
    Mixed.Cohort ι .ownedOnly .arithmetic where
  descriptor subject := descriptor (subjects subject).site (subjects subject).call
  post subject := Post (subjects subject).site (subjects subject).call
  annotations subject := (subjects subject).proof.annotations
  profile_eq subject := (subjects subject).ownedOnly
  family_eq _subject := rfl
  callerPolicy subject state :=
    descriptor_policy (subjects subject).site (subjects subject).call state

/-- Each entry uses the node and annotations of the same supplied bundle. -/
theorem provedCohort_entries {ι : Type} {initial : S}
    (subjects : ι → ProvedSubject initial) : (provedCohort subjects).Entries initial :=
  fun subject => ⟨(subjects subject).proof.ranked.node, (subjects subject).proof.entry⟩

/-- The selected entries derive empty queues and current closure through the
complete actual action and observation lists, without identifying ghosts. -/
theorem provedCohort_closed {ι : Type} {initial final : S}
    (subjects : ι → ProvedSubject initial)
    (covered : (provedCohort subjects).Covers initial) (empty : Quiescent initial)
    {actions : List Action} {observations : List O}
    (actual : TSO64.schedule initial actions .ownedOnly .arithmetic = .ok (final, observations)) :
    Quiescent final ∧ (provedCohort subjects).Covers final ∧
      (provedCohort subjects).Current initial final ∧
      (provedCohort subjects).RetirementTrace actions observations :=
  (provedCohort subjects).schedule covered (provedCohort_entries subjects) empty actual

/-- Original shape combines with this bundle's actual completed resources and
current schedule validity to admit cleanup of the actual returned worker. -/
theorem retirement_ready {c : Compiler} {site : Site c} {call : Call}
    {initial final : S} (pre : Pre site call initial) (proof : ProofBundle site call initial)
    {actions : List Action} {observations : List O}
    (actual : TSO64.schedule initial actions site.profile .arithmetic = .ok (final, observations))
    {worker : Worker} (live : final.workers[site.tid]? = some worker)
    (returned : worker.phase = .returned) (empty : worker.pending = [])
    {identifier : Atomics64.HandleId64}
    (singleton : site.original.resources.atomics = [identifier])
    (distinct : site.original.resources.code.identifier ≠ site.original.resources.caller.identifier) :
    Lifecycle.Ready final.world worker identifier := by
  have retained := proof.completed_resources actual live returned
  have valid := TSO64.schedule_wellFormed pre.admitted.wellFormed actual
  refine ⟨returned, empty, ?_, (valid.2 worker (List.mem_of_getElem? live)).1, ?_⟩
  · rw [retained]
    exact singleton
  · rw [retained]
    exact distinct

/-- Coverage selects a supplied proof for each actual final worker. Closure
provides its current empty queue; only original cleanup shapes are inputs. -/
theorem provedCohort_retirement_ready {ι : Type} {initial final : S}
    (subjects : ι → ProvedSubject initial)
    (covered : (provedCohort subjects).Covers initial) (empty : Quiescent initial)
    (shapes : ∀ subject, CleanupShape (subjects subject).site)
    {actions : List Action} {observations : List O}
    (actual : TSO64.schedule initial actions .ownedOnly .arithmetic = .ok (final, observations))
    (returned : ∀ worker ∈ final.workers, worker.phase = .returned) :
    ∀ worker ∈ final.workers, ∃ identifier, Lifecycle.Ready final.world worker identifier := by
  obtain ⟨finalEmpty, finalCovered, _current, _retiring⟩ :=
    provedCohort_closed subjects covered empty actual
  intro worker member
  obtain ⟨tid, live⟩ := List.mem_iff_getElem?.mp member
  obtain ⟨subject, subjectTid⟩ := finalCovered tid worker live
  change (subjects subject).site.tid = tid at subjectTid
  have subjectLive : final.workers[(subjects subject).site.tid]? = some worker := by
    rw [subjectTid]
    exact live
  have subjectRun : TSO64.schedule initial actions (subjects subject).site.profile .arithmetic =
      .ok (final, observations) := by
    rw [(subjects subject).ownedOnly]
    exact actual
  obtain ⟨identifier, singleton, distinct⟩ := shapes subject
  exact ⟨identifier, retirement_ready (subjects subject).pre (subjects subject).proof
    subjectRun subjectLive (returned worker member) (finalEmpty worker member) singleton distinct⟩

/-- Execute production retirement with derived current Ready and separation.
All preservation and revocation results concern the actual cleanup world. -/
theorem provedCohort_retireAll {ι : Type} {initial final : S}
    (subjects : ι → ProvedSubject initial)
    (valid : WellFormed initial .ownedOnly)
    (covered : (provedCohort subjects).Covers initial) (empty : Quiescent initial)
    (shapes : ∀ subject, CleanupShape (subjects subject).site)
    (separate : initial.workers.reverse.Pairwise
      (fun retiring peer => Lifecycle.Separate retiring.resources peer.resources))
    {actions : List Action} {observations : List O}
    (actual : TSO64.schedule initial actions .ownedOnly .arithmetic = .ok (final, observations))
    (returned : ∀ worker ∈ final.workers, worker.phase = .returned) :
    ∃ result, Lifecycle.retireAll final = .ok result ∧ WellFormed result.1 .ownedOnly ∧
      result.1.workers = [] ∧ result.2 = final.workers.reverse.map Worker.context ∧
      result.1.world.legacy.shared.resources = final.world.legacy.shared.resources ∧
      result.1.world.cells = final.world.cells ∧ published result.1.world = published final.world ∧
      (∃ labels, Atomics64.History final.world labels result.1.world) ∧
      ∀ worker ∈ final.workers, Lifecycle.WorkerRevoked result.1.world worker := by
  exact Lifecycle.retireAll_ready (TSO64.schedule_wellFormed valid actual)
    (provedCohort_retirement_ready subjects covered empty shapes actual returned)
    (schedule_retirement_separate actual separate)

/-- Two explicitly selected proofs assemble full-log counts and unit events
with production OS-history conservation at the independently registered cell. -/
theorem two_completed_total {leftCompiler rightCompiler : Compiler}
    {left : Site leftCompiler} {right : Site rightCompiler} {leftCall rightCall : Call}
    {initial final : S}
    (leftPre : Pre left leftCall initial) (rightPre : Pre right rightCall initial)
    (leftProof : ProofBundle left leftCall initial) (rightProof : ProofBundle right rightCall initial)
    (leftProfile : left.profile = .ownedOnly) (rightProfile : right.profile = .ownedOnly)
    (leftSlot : left.tid = 0) (rightSlot : right.tid = 1)
    (workerUniverse : initial.workers.length = 2)
    {actions : List Action} {observations : List O}
    (actual : TSO64.schedule initial actions .ownedOnly .arithmetic = .ok (final, observations))
    {leftWorker rightWorker : Worker}
    (leftLive : final.workers[left.tid]? = some leftWorker)
    (rightLive : final.workers[right.tid]? = some rightWorker)
    (leftReturned : leftWorker.phase = .returned) (rightReturned : rightWorker.phase = .returned)
    (target : Atomics64.CellId64) (cell : Atomics64.Cell)
    (registered : initial.world.cells target = some cell)
    (leftTarget : leftCall.target = target) (rightTarget : rightCall.target = target)
    (prior : Word)
    (readBefore : loadQWord (AddressSpace.toMemory initial.world.legacy.shared.resources.space)
      cell.address = .ok prior) :
    ∃ value,
      loadQWord (AddressSpace.toMemory final.world.legacy.shared.resources.space)
        cell.address = .ok value ∧
      value.toNat =
        (prior.toNat + leftCall.iterations.toNat + rightCall.iterations.toNat) % 2^64 := by
  let leftSubject : ProvedSubject initial :=
    ⟨leftCompiler, left, leftCall, leftPre, leftProfile, leftProof⟩
  let rightSubject : ProvedSubject initial :=
    ⟨rightCompiler, right, rightCall, rightPre, rightProfile, rightProof⟩
  have leftRun : TSO64.schedule initial actions left.profile .arithmetic =
      .ok (final, observations) := by rw [leftProfile]; exact actual
  have rightRun : TSO64.schedule initial actions right.profile .arithmetic =
      .ok (final, observations) := by rw [rightProfile]; exact actual
  have leftCount : Mixed.Counts.countRMW left.tid observations = leftCall.iterations.toNat :=
    leftSubject.proof.completed_count leftRun leftLive leftReturned
  have rightCount : Mixed.Counts.countRMW right.tid observations = rightCall.iterations.toNat :=
    rightSubject.proof.completed_count rightRun rightLive rightReturned
  have leftEvents : ∀ event, Observation.rmw left.tid event ∈ observations →
      EventOK left leftCall event :=
    leftSubject.proof.completed_events leftRun leftLive leftReturned
  have rightEvents : ∀ event, Observation.rmw right.tid event ∈ observations →
      EventOK right rightCall event :=
    rightSubject.proof.completed_events rightRun rightLive rightReturned
  have covered : ∀ tid event, Observation.rmw tid event ∈ observations → tid = 0 ∨ tid = 1 := by
    intro tid event member
    have bound := ScheduleTrace.rmw_tid_lt actual member
    rw [workerUniverse] at bound
    omega
  have increments : ∀ tid event, Observation.rmw tid event ∈ observations →
      event.cell = target ∧ event.arithmetic.delta = 1 := by
    intro tid event member
    rcases covered tid event member with leftIssuer | rightIssuer
    · have observed : Observation.rmw left.tid event ∈ observations := by
        simpa only [leftSlot, leftIssuer] using member
      have eventOK := leftEvents event observed
      exact ⟨eventOK.2.1.trans leftTarget, eventOK.2.2.2.1⟩
    · have observed : Observation.rmw right.tid event ∈ observations := by
        simpa only [rightSlot, rightIssuer] using member
      have eventOK := rightEvents event observed
      exact ⟨eventOK.2.1.trans rightTarget, eventOK.2.2.2.1⟩
  have total : Mixed.EventCounts.totalRMW observations =
      leftCall.iterations.toNat + rightCall.iterations.toNat :=
    Mixed.EventCounts.totalRMW_eq_two_of_counts (left := 0) (right := 1) (by decide)
      covered (by simpa only [leftSlot] using leftCount)
      (by simpa only [rightSlot] using rightCount)
  have valid : WellFormed initial := by
    simpa only [descriptor, leftProfile] using leftPre.admitted.wellFormed
  obtain ⟨value, readAfter, legal⟩ := TSO64History.schedule_sequential valid actual target cell
    registered (fun _ => ()) (fun event => event.actor) prior readBefore
  have inputTotal := Mixed.EventCounts.inputSum_selectedCalls_eq_totalRMW target
    (fun _ => ()) (fun event => event.actor) observations increments
  refine ⟨value, readAfter, ?_⟩
  rw [legal.total, inputTotal, total]
  simp only [Nat.add_assoc]

/-- The selected entries and actual observed targets supply the generic byte
frame, including checked address/registry alignment on the actual schedule. -/
theorem two_completed_frame {leftCompiler rightCompiler : Compiler}
    {left : Site leftCompiler} {right : Site rightCompiler} {leftCall rightCall : Call}
    {initial final : S}
    (leftPre : Pre left leftCall initial) (rightPre : Pre right rightCall initial)
    (leftProof : ProofBundle left leftCall initial) (rightProof : ProofBundle right rightCall initial)
    (leftProfile : left.profile = .ownedOnly) (rightProfile : right.profile = .ownedOnly)
    (leftSlot : left.tid = 0) (rightSlot : right.tid = 1)
    (workerUniverse : initial.workers.length = 2) (empty : Quiescent initial)
    {actions : List Action} {observations : List O}
    (actual : TSO64.schedule initial actions .ownedOnly .arithmetic = .ok (final, observations))
    {leftWorker rightWorker : Worker}
    (leftLive : final.workers[left.tid]? = some leftWorker)
    (rightLive : final.workers[right.tid]? = some rightWorker)
    (leftReturned : leftWorker.phase = .returned) (rightReturned : rightWorker.phase = .returned)
    (target : Atomics64.CellId64) (cell : Atomics64.Cell)
    (registered : initial.world.cells target = some cell)
    (leftTarget : leftCall.target = target) (rightTarget : rightCall.target = target) :
    ∀ query : Word, 8 ≤ (query - cell.address).toNat →
      (published final.world).read query = (published initial.world).read query := by
  let subjects : Bool → ProvedSubject initial := fun subject => match subject with
    | false => ⟨leftCompiler, left, leftCall, leftPre, leftProfile, leftProof⟩
    | true => ⟨rightCompiler, right, rightCall, rightPre, rightProfile, rightProof⟩
  let cohort := provedCohort subjects
  have covered : cohort.Covers initial := by
    intro tid worker live
    have bound := (List.getElem_of_getElem? live).1
    rw [workerUniverse] at bound
    have slots : tid = 0 ∨ tid = 1 := by omega
    rcases slots with rfl | rfl
    · exact ⟨false, leftSlot⟩
    · exact ⟨true, rightSlot⟩
  have entries : cohort.Entries initial := provedCohort_entries subjects
  have leftRun : TSO64.schedule initial actions left.profile .arithmetic =
      .ok (final, observations) := by rw [leftProfile]; exact actual
  have rightRun : TSO64.schedule initial actions right.profile .arithmetic =
      .ok (final, observations) := by rw [rightProfile]; exact actual
  have leftEvents := leftProof.completed_events leftRun leftLive leftReturned
  have rightEvents := rightProof.completed_events rightRun rightLive rightReturned
  have targets : ∀ tid event, Observation.rmw tid event ∈ observations → event.cell = target := by
    intro tid event member
    have bound := ScheduleTrace.rmw_tid_lt actual member
    rw [workerUniverse] at bound
    have slots : tid = 0 ∨ tid = 1 := by omega
    rcases slots with leftIssuer | rightIssuer
    · have observed : Observation.rmw left.tid event ∈ observations := by
        simpa only [leftSlot, leftIssuer] using member
      exact (leftEvents event observed).2.1.trans leftTarget
    · have observed : Observation.rmw right.tid event ∈ observations := by
        simpa only [rightSlot, rightIssuer] using member
      exact (rightEvents event observed).2.1.trans rightTarget
  exact cohort.schedule_frame covered entries empty registered targets actual

/-- Preserve the original total/frame contract with explicit selected proofs
inserted immediately after the two independent admission arguments. -/
theorem two_completed_total_frame {leftCompiler rightCompiler : Compiler}
    {left : Site leftCompiler} {right : Site rightCompiler} {leftCall rightCall : Call}
    {initial final : S}
    (leftPre : Pre left leftCall initial) (rightPre : Pre right rightCall initial)
    (leftProof : ProofBundle left leftCall initial) (rightProof : ProofBundle right rightCall initial)
    (leftProfile : left.profile = .ownedOnly) (rightProfile : right.profile = .ownedOnly)
    (leftSlot : left.tid = 0) (rightSlot : right.tid = 1)
    (workerUniverse : initial.workers.length = 2) (empty : Quiescent initial)
    {actions : List Action} {observations : List O}
    (actual : TSO64.schedule initial actions .ownedOnly .arithmetic = .ok (final, observations))
    {leftWorker rightWorker : Worker}
    (leftLive : final.workers[left.tid]? = some leftWorker)
    (rightLive : final.workers[right.tid]? = some rightWorker)
    (leftReturned : leftWorker.phase = .returned) (rightReturned : rightWorker.phase = .returned)
    (target : Atomics64.CellId64) (cell : Atomics64.Cell)
    (registered : initial.world.cells target = some cell)
    (leftTarget : leftCall.target = target) (rightTarget : rightCall.target = target)
    (prior : Word)
    (readBefore : loadQWord (published initial.world) cell.address = .ok prior) :
    ∃ value,
      loadQWord (published final.world) cell.address = .ok value ∧
      value.toNat =
        (prior.toNat + leftCall.iterations.toNat + rightCall.iterations.toNat) % 2^64 ∧
      ∀ query : Word, 8 ≤ (query - cell.address).toNat →
        (published final.world).read query = (published initial.world).read query := by
  obtain ⟨value, readAfter, total⟩ := two_completed_total leftPre rightPre leftProof rightProof
    leftProfile rightProfile leftSlot rightSlot workerUniverse actual leftLive rightLive
    leftReturned rightReturned target cell registered leftTarget rightTarget prior readBefore
  exact ⟨value, readAfter, total,
    two_completed_frame leftPre rightPre leftProof rightProof leftProfile rightProfile
      leftSlot rightSlot workerUniverse empty actual leftLive rightLive leftReturned rightReturned
      target cell registered leftTarget rightTarget⟩

/-- Preserve the original retired-total contract using selected resources,
derived current readiness and actual production cleanup at the real endpoint. -/
theorem two_completed_retired_total {leftCompiler rightCompiler : Compiler}
    {left : Site leftCompiler} {right : Site rightCompiler} {leftCall rightCall : Call}
    {initial final : S}
    (leftPre : Pre left leftCall initial) (rightPre : Pre right rightCall initial)
    (leftProof : ProofBundle left leftCall initial) (rightProof : ProofBundle right rightCall initial)
    (leftProfile : left.profile = .ownedOnly) (rightProfile : right.profile = .ownedOnly)
    (leftSlot : left.tid = 0) (rightSlot : right.tid = 1)
    (workerUniverse : initial.workers.length = 2)
    (empty : Quiescent initial) (leftShape : CleanupShape left) (rightShape : CleanupShape right)
    (separate : initial.workers.reverse.Pairwise
      (fun retiring peer => Lifecycle.Separate retiring.resources peer.resources))
    {actions : List Action} {observations : List O}
    (actual : TSO64.schedule initial actions .ownedOnly .arithmetic = .ok (final, observations))
    {leftWorker rightWorker : Worker}
    (leftLive : final.workers[left.tid]? = some leftWorker)
    (rightLive : final.workers[right.tid]? = some rightWorker)
    (leftReturned : leftWorker.phase = .returned) (rightReturned : rightWorker.phase = .returned)
    (target : Atomics64.CellId64) (cell : Atomics64.Cell)
    (registered : initial.world.cells target = some cell)
    (leftTarget : leftCall.target = target) (rightTarget : rightCall.target = target)
    (prior : Word)
    (readBefore : loadQWord (AddressSpace.toMemory initial.world.legacy.shared.resources.space)
      cell.address = .ok prior) :
    ∃ result value,
      Lifecycle.retireAll final = .ok result ∧ WellFormed result.1 .ownedOnly ∧
      result.1.workers = [] ∧ result.2 = final.workers.reverse.map Worker.context ∧
      result.1.world.legacy.shared.resources = final.world.legacy.shared.resources ∧
      result.1.world.cells = final.world.cells ∧ published result.1.world = published final.world ∧
      (∃ labels, Atomics64.History final.world labels result.1.world) ∧
      (∀ worker ∈ final.workers, Lifecycle.WorkerRevoked result.1.world worker) ∧
      loadQWord (AddressSpace.toMemory result.1.world.legacy.shared.resources.space)
        cell.address = .ok value ∧
      value.toNat =
        (prior.toNat + leftCall.iterations.toNat + rightCall.iterations.toNat) % 2^64 := by
  let subjects : Bool → ProvedSubject initial := fun side =>
    match side with
    | false => ⟨leftCompiler, left, leftCall, leftPre, leftProfile, leftProof⟩
    | true => ⟨rightCompiler, right, rightCall, rightPre, rightProfile, rightProof⟩
  have covered : (provedCohort subjects).Covers initial := by
    intro tid worker live
    have bound := (List.getElem_of_getElem? live).1
    rw [workerUniverse] at bound
    have slot : tid = 0 ∨ tid = 1 := by omega
    rcases slot with atLeft | atRight
    · refine ⟨false, ?_⟩
      change left.tid = tid
      exact leftSlot.trans atLeft.symm
    · refine ⟨true, ?_⟩
      change right.tid = tid
      exact rightSlot.trans atRight.symm
  have shapes : ∀ subject, CleanupShape (subjects subject).site := by
    intro subject
    cases subject with
    | false => exact leftShape
    | true => exact rightShape
  have valid : WellFormed initial .ownedOnly := by
    simpa only [descriptor, leftProfile] using leftPre.admitted.wellFormed
  have finalLength : final.workers.length = 2 :=
    (ScheduleTrace.workers_length actual).trans workerUniverse
  have returned : ∀ worker ∈ final.workers, worker.phase = .returned := by
    intro worker member
    obtain ⟨tid, live⟩ := List.mem_iff_getElem?.mp member
    have bound := (List.getElem_of_getElem? live).1
    rw [finalLength] at bound
    have slot : tid = 0 ∨ tid = 1 := by omega
    rcases slot with atLeft | atRight
    · have atSite : final.workers[left.tid]? = some worker := by
        rw [leftSlot, ← atLeft]
        exact live
      have same : worker = leftWorker := Option.some.inj (atSite.symm.trans leftLive)
      exact (congrArg Worker.phase same).trans leftReturned
    · have atSite : final.workers[right.tid]? = some worker := by
        rw [rightSlot, ← atRight]
        exact live
      have same : worker = rightWorker := Option.some.inj (atSite.symm.trans rightLive)
      exact (congrArg Worker.phase same).trans rightReturned
  obtain ⟨result, success, afterValid, workers, contexts, resources, cells, ram,
      history, revoked⟩ :=
    provedCohort_retireAll subjects valid covered empty shapes separate actual returned
  obtain ⟨value, readAfter, total⟩ :=
    two_completed_total leftPre rightPre leftProof rightProof leftProfile rightProfile
      leftSlot rightSlot workerUniverse actual leftLive rightLive leftReturned rightReturned
      target cell registered leftTarget rightTarget prior readBefore
  refine ⟨result, value, success, afterValid, workers, contexts, resources, cells, ram,
    history, revoked, ?_, total⟩
  change loadQWord (published result.1.world) cell.address = .ok value
  rw [ram]
  exact readAfter

#print axioms provedCohort
#print axioms provedCohort_entries
#print axioms provedCohort_closed
#print axioms retirement_ready
#print axioms provedCohort_retirement_ready
#print axioms provedCohort_retireAll
#print axioms two_completed_total
#print axioms two_completed_frame
#print axioms two_completed_total_frame
#print axioms two_completed_retired_total

end EDSL.Corpus.V1.CounterCommon.Selected

